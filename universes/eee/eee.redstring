      "3d4d21f7-fbf2-41c9-9405-20832e1f4afc": {
        "@type": [
          "redstring:Prototype",
          "rdfs:Class",
          "schema:Thing"
        ],
        "@id": "prototype:3d4d21f7-fbf2-41c9-9405-20832e1f4afc",
        "rdfs:label": "TEST REPO",
        "rdfs:comment": "On September 17, 2019, interest rates on overnight repurchase agreements, which are short-term loans between financial institutions, experienced a sudden and unexpected spike. A measure of the interest rate on overnight repos in the United States, the Secured Overnight Financing Rate (SOFR), increased from 2.43 percent on September 16 to 5.25 percent on September 17. During the trading day, interest rates reached as high as 10 percent. The activity also affected the interest rates on unsecured loans between financial institutions, and the Effective Federal Funds Rate (EFFR), which serves as a measure for such interest rates, moved above its target range determined by the Federal Reserve.",
        "name": "TEST REPO",
        "description": "On September 17, 2019, interest rates on overnight repurchase agreements, which are short-term loans between financial institutions, experienced a sudden and unexpected spike. A measure of the interest rate on overnight repos in the United States, the Secured Overnight Financing Rate (SOFR), increased from 2.43 percent on September 16 to 5.25 percent on September 17. During the trading day, interest rates reached as high as 10 percent. The activity also affected the interest rates on unsecured loans between financial institutions, and the Effective Federal Funds Rate (EFFR), which serves as a measure for such interest rates, moved above its target range determined by the Federal Reserve.",
        "rdfs:seeAlso": [
          "https://en.wikipedia.org/wiki/September_2019_events_in_the_U.S._repo_market"
        ],
        "rdfs:isDefinedBy": {
          "@id": "https://redstring.io"
        },
        "rdfs:subClassOf": {
          "@id": "type:base-thing-prototype"
        },
        "owl:sameAs": [
