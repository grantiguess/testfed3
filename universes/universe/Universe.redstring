      "be1d91cb-d54b-4f15-8299-9fa7f2e516d9": {
        "@type": [
          "redstring:Prototype",
          "rdfs:Class",
          "schema:Thing"
        ],
        "@id": "prototype:be1d91cb-d54b-4f15-8299-9fa7f2e516d9",
        "rdfs:label": "Lightspeed SKUs to Add / Remove",
        "rdfs:comment": "This spreadsheet takes Finale reports that generate based on Finale counts and sales and uses that to make a list of flower products to add to Lightspeed and a list to remove. It also uses a list of active flower stock to cross reference with dates and a set value for the number of days until it recommends the strain be put on sale. After those days, it will appear on sale on Lightspeed. This sheet controls what sales are also listed on sale on the menu through dropdown on the Lightspeed SKUs page.",
        "name": "Lightspeed SKUs to Add / Remove",
        "description": "This spreadsheet takes Finale reports that generate based on Finale counts and sales and uses that to make a list of flower products to add to Lightspeed and a list to remove. It also uses a list of active flower stock to cross reference with dates and a set value for the number of days until it recommends the strain be put on sale. After those days, it will appear on sale on Lightspeed. This sheet controls what sales are also listed on sale on the menu through dropdown on the Lightspeed SKUs page.",
