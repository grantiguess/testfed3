      "378a96bc-bd5a-449e-b700-409341982450": {
        "@type": [
          "redstring:Prototype",
          "rdfs:Class",
          "schema:Thing"
        ],
        "@id": "prototype:378a96bc-bd5a-449e-b700-409341982450",
        "rdfs:label": "Finale-Bigcommerce Integration",
        "rdfs:comment": "Finale Inventory hosts an integration server with BigCommerce where it periodically searches BigCommerce for matching SKUs (Product IDs), links them with Finale, and then pushes Finale Inventory counts to BigCommerce, which then shows up on the website. When sales are made on BigCommerce, the integration checks for them and then imports them into Finale as sales orders, deducting the Finale stock count.",
        "name": "Finale-Bigcommerce Integration",
        "description": "Finale Inventory hosts an integration server with BigCommerce where it periodically searches BigCommerce for matching SKUs (Product IDs), links them with Finale, and then pushes Finale Inventory counts to BigCommerce, which then shows up on the website. When sales are made on BigCommerce, the integration checks for them and then imports them into Finale as sales orders, deducting the Finale stock count.",
        "rdfs:seeAlso": [],
        "rdfs:isDefinedBy": {
