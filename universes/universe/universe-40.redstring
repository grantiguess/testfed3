      "semantic-node-1757205365512-8j5t221yw": {
        "@type": [
          "redstring:Prototype",
          "rdfs:Class",
          "schema:Thing"
        ],
        "@id": "prototype:semantic-node-1757205365512-8j5t221yw",
        "rdfs:label": "Carol + 2",
        "rdfs:comment": "Carol + 2 is the second of a multi-year series of variety television specials starring Carol Burnett, aired on CBS network in the United States between 1962 and 1989. The first special, Julie and Carol at Carnegie Hall, was aired in 1962. It featured Burnett and Julie Andrews. On March 22, 1966, Carol + 2 aired, in which Carol was joined by actor Zero Mostel and comedien Lucille Ball.[1]",
