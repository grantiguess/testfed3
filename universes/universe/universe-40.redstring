    "title": "Better Call Saul",
    "description": "Better Call Saul is an AMC show that is one of the best shows ever made and easily the best legal drama ever made. It is about 2 undiagnosed neurodivergent people destroying the lives of everyone around them because of their daddy and mommy issues and the cartel.",
    "domain": null,
    "userURIs": null,
    "semanticWebCompliant": true,
    "rdfSchemaVersion": "1.1",
    "owlVersion": "2.0"
  },
